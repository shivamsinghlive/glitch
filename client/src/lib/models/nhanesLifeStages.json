013,"diffLo":-0.1637,"diffHi":-0.0388,"q":0.064,"significant":false},"breastfeeding":{"n":117,"suppressed":false,"p":0.0083,"or":1.8671,"orLo":1.184,"orHi":2.9442,"adjRef":0.2411,"adjStage":0.3707,"diff":0.1296,"diffLo":0.024,"diffHi":0.2351,"q":0.064,"significant":false},"post":{"n":759,"suppressed":false,"p":0.9746,"or":1.0062,"orLo":0.6824,"orHi":1.4836,"adjRef":0.2411,"adjStage":0.2422,"diff":0.0011,"diffLo":-0.0694,"diffHi":0.0716,"q":0.9746,"significant":false}},"sensitivity":{"plusBmi":{"pregnant":{"n":188,"suppressed":false,"p":0.0087,"or":0.4997,"orLo":0.3002,"orHi":0.8318,"adjRef":0.241,"adjStage":0.138,"diff":-0.103,"diffLo":-0.1633,"diffHi":-0.0426},"breastfeeding":{"n":117,"suppressed":false,"p":0.0058,"or":1.9316,"orLo":1.2225,"orHi":3.052,"adjRef":0.241,"adjStage":0.3774,"diff":0.1364,"diffLo":0.0306,"diffHi":0.2423},"post":{"n":752,"suppressed":false,"p":0.9095,"or":1.0221,"orLo":0.6952,"orHi":1.5028,"adjRef":0.241,"adjStage":0.245,"diff":0.004,"diffLo":-0.0661,"diffHi":0.0741}},"ageMatched":{"pregnant":{"n":189,"suppressed":false,"p":0.0093,"or":0.4977,"orLo":0.2967,"orHi":0.8349,"adjRef":0.2349,"adjStage":0.133,"diff":-0.1019,"diffLo":-0.1645,"diffHi":-0.0392},"breastfeeding":{"n":117,"suppressed":false,"p":0.0156,"or":1.7823,"orLo":1.1215,"orHi":2.8327,"adjRef":0.2349,"adjStage":0.3526,"diff":0.1177,"diffLo":0.0132,"diffHi":0.2222},"post":{"n":759,"suppressed":false,"p":0.9094,"or":0.976,"orLo":0.6367,"orHi":1.4961,"adjRef":0.2648,"adjStage":0.2601,"diff":-0.0046,"diffLo":-0.0859,"diffHi":0.0767}},"recentBirth12m":{"n":237,"suppressed":false,"p":0.0009,"or":1.9894,"orLo":1.3458,"orHi":2.9406,"adjRef":0.2313,"adjStage":0.3727,"diff":0.1414,"diffLo":0.0513,"diffHi":0.2314}}}],"suppressionRule":"Cells with fewer than 30 women or fewer than 10 events (or non-events) are suppressed (NCHS-style reliability).","notes":["Cross-sectional: associations at one point in time, not effects of a life stage.","Breastfeeding is a proxy for postpartum: NHANES has no direct postpartum flag, and it misses postpartum women who are not breastfeeding (the 'birth in past 12 months' sensitivity analysis covers them).","Pregnant and breastfeeding groups are small (about 150–200 women each), so confidence intervals are wide; 'no significant difference' is not evidence of no difference.","Post-menopausal women are mostly 45+ and cycling women mostly under 50; age is adjusted for, but the age-matched sensitivity analysis (40–59 only) is the fairer comparison.","Pregnancy status is only recorded for ages 20–44; older women are assumed not pregnant. Women whose pregnancy status could not be determined are excluded.","'Trouble sleeping' means ever having told a doctor about it, not current symptoms; pregnant women's sleep complaints may be under-captured.","Sleep-hours question changed in 2015 (SLD010H 'usual sleep' to SLD012 'weekday/workday sleep').","PHQ-9 screens for depressive symptoms over two weeks; it is not a diagnosis, and somatic items (sleep, fatigue, appetite) overlap with normal pregnancy.","Perimenopause cannot be identified, so 'cycling' includes women in the menopause transition.","Surgical menopause (hysterectomy or both ovaries removed) is excluded as a different exposure.","The 'birth in past 12 months' group overlaps heavily with breastfeeding women, so agreement between the two is not independent confirmation.","644 women had no reproductive-health interview record and were excluded; complete-case analysis otherwise.","Depression symptoms in breastfeeding women are suppressed (fewer than 10 women with PHQ-9 ≥10); the PHQ-9 score is reported instead."]}
